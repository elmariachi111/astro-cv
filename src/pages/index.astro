---
import CardExperience from "../components/card-experience.astro";
import Layout from "../layouts/Layout.astro";

import Education from "../components/Education.astro";
import ImageSection from "../components/sidebar/image-section.astro";
import PersonalInformation from "../components/sidebar/personal-information.astro";
import Skills from "../components/sidebar/skills.astro";
import Stations from "../components/sidebar/stations.astro";
import SkillCard from "../components/skill-card.astro";

import jpg_warranti from "../assets/warranti.jpg";
import jpg_takeover from "../assets/takeover_panel.jpg";
import jpg_ctPanel from "../assets/ct_panel.jpg";
import jpg_check from "../assets/check.jpg";
---

<Layout title="CV | Stefan Adolf">
  {/* Main content */}
  <main class="flex flex-col sm:flex-row">
    {/* Left Column - Inverted style */}
    <div class="sm:w-1/3 bg-gray-800 text-white px-8 pb-8 space-y-8">
      <ImageSection />

      <PersonalInformation />

      <Skills
        skills={[
          "TypeScript",
          "React",
          "Node",
          "GraphQL",
          "Testing",
          "Docker",
          "GCP",
          "PostgreSQL",
          "MongoDB",
          "ElasticSearch",
          "Python",
          "Mathematics",
        ]}
      />
      <Stations />

      <Education />
    </div>

    {/* Right Column */}
    <div class="sm:w-2/3 bg-white p-8 space-y-8">
      <section class="flex flex-col gap-12">

        {/* Bio / Transition Block */}
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6 space-y-3">
          <h2 class="text-2xl font-semibold text-emerald-900">Currently: Climate</h2>
          <p class="text-gray-700 leading-relaxed">
            I'm a senior software engineer with 25 years of building production systems —
            currently making a deliberate pivot into climate tech, sustainability, and
            public-interest engineering.
          </p>
          <p class="text-gray-700 leading-relaxed">
            My background is in data infrastructure, research platforms, and privacy-preserving
            systems. At <a href="https://welshare.health" class="content-link" target="_blank" rel="noopener noreferrer">welshare</a> I'm
            building the infrastructure for citizen-owned health data contribution to science.
            Before that, at <a href="https://molecule.xyz" class="content-link" target="_blank" rel="noopener noreferrer">Molecule</a>,
            I built the funding infrastructure for decentralized scientific research.
            Both are direct precedents for what climate work needs at its core: trusted data systems,
            novel coordination mechanisms, and open infrastructure for science.
          </p>
          <p class="text-gray-700 leading-relaxed">
            I'm looking for senior engineering, tech lead, or CTO-adjacent roles at climate
            organizations, research institutes, policy bodies, or mission-driven startups.
            Based in Berlin — open to Germany, Europe, and the UK.
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            {["Data Infrastructure", "Research Platforms", "Privacy Tech", "Open Source", "Team Leadership", "Technical Strategy"].map(tag => (
              <span class="bg-emerald-100 text-emerald-800 text-xs font-medium px-2.5 py-1 rounded-full">{tag}</span>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <h2 class="text-2xl font-semibold mb-4">
            Professional Work Experience
          </h2>
          <CardExperience
            title="CTO / Co Founder"
            position="welshare"
            href="https://welshare.health"
            time="Mar 2025 - now"
          >
            <p>
              Building infrastructure for citizens to own and contribute health data to science
              without surrendering privacy. Enabling researchers to access valuable datasets
              while preserving participant sovereignty and consent.
            </p>
            <p>
              <ul class="list-disc list-inside space-y-1 w-full">
                <li>Data sovereignty architecture for research participation</li>
                <li>Secure data ingestion and validation APIs</li>
                <li>Wearable ecosystem adapters (Apple Health, Google Fit, etc.)</li>
                <li>Cryptographic access controls and privacy-preserving mechanisms</li>
                <li>User experience for complex research workflows</li>
                <li>ML-ready data pipelines for scientific analysis</li>
              </ul>
            </p>
            <p class="text-sm text-gray-600 mt-2">
              <em>Climate parallel:</em> This same architecture pattern powers distributed climate monitoring,
              citizen science data collection, air quality sensing networks, and biodiversity research platforms.
            </p>
          </CardExperience>
          <CardExperience
            title="Lead Infrastructure Developer"
            position="Molecule AG — Decentralized Science"
            href="https://molecule.xyz"
            time="Oct 2022 - Mar 2025"
          >
            <p>
              Built IP and research funding infrastructure for decentralized science.
              Developed novel crowdfunding mechanisms and tokenization systems for scientific research projects,
              enabling researchers to secure funding outside traditional grant structures.
            </p>
            <ul class="list-disc list-inside space-y-1 w-full">
              <li>
                Research IP infrastructure and crowdfunding systems
                <p class="text-sm">
                  Open source infrastructure for scientific IP management (<a
                    href="https://github.com/moleculeprotocol/IPNFT"
                    target="_blank"
                    rel="noopener noreferrer"
                    >github.com/moleculeprotocol/IPNFT</a>).
                  Comprehensive test coverage, audit support, CI/CD automation.
                  Built indexing infrastructure (subgraphs) for research project discovery.
                </p>
              </li>
              <li>
                Novel funding mechanisms for research
                <p class="text-sm">
                  Designed and implemented dynamic pricing curves and market mechanisms
                  for research funding (<a href="https://catalyst.molecule.xyz" target="_blank"
                    >catalyst.molecule.xyz</a>). Configurable economic models,
                  sophisticated state transitions, custom metadata APIs.
                </p>
              </li>
              <li>
                Full-stack contributor to research platforms
                <p class="text-sm">
                  Built frontend applications using Next.js/React/TypeScript.
                  Integrated decentralized storage (Arweave, IPFS), encryption layers,
                  and authentication systems for research data workflows.
                </p>
              </li>
              <li>MD for German subsidiary (Desci Entwicklungsgesellschaft mbH)</li>
            </ul>
            <p class="text-sm text-gray-600 mt-2">
              <em>Climate parallel:</em> Novel funding mechanisms for climate research and innovation.
              Carbon credit systems, climate bond mechanisms, open climate research funding platforms.
              Same infrastructure patterns apply to any research coordination problem.
            </p>
          </CardExperience>
          <CardExperience
            title="Developer Ambassador"
            position="Turbine Kreuzberg"
            time="Jan 2018 - Dec 2021"
            href="https://turbinekreuzberg.com"
          >
            <p>
              Technical community builder and developer relations lead. Represented complex
              engineering capabilities to non-technical audiences. Speaker, educator, bridge-builder
              between technical and strategic worlds.
            </p>
            <ul class="list-disc list-inside space-y-1 w-full">
              <li>
                Public technical representation
                <p class="text-sm">
                  Represented agency at events, meetups, and conferences across Europe.
                  Media exposure in security, IT, and health publications.
                  Ran local developer meetup groups (Coding Earth) across multiple cities.
                </p>
              </li>
              <li>
                Specialist engineering projects
                <p class="text-sm">
                  Built backend APIs for automated supply chain solutions. Full-stack
                  management interfaces (Vue 2, Vuetify). Headless CMS integrations,
                  Kubernetes debugging, cloud deployments, architecture consulting.
                </p>
              </li>
              <li>
                Medical data sovereignty and identity infrastructure
                <p class="text-sm">
                  Led technical development of "DePA" (medical health records platform).
                  Identity solutions using W3C/DID & Verifiable Credentials.
                  Built universal Covid immunization certificate verifier (<a
                    href="https://github.com/elmariachi111/ultimate-non-infectious-verifier"
                    target="_blank">Univax</a>).
                </p>
              </li>
              <li>
                University collaboration (HTW Berlin): supported 5 student groups with
                techno-economical project concepts
              </li>
              <li>Technical sales support and client education</li>
            </ul>
            <p class="text-sm text-gray-600 mt-2">
              <em>Why this matters:</em> Climate organizations constantly need this bridge between
              technical capabilities and strategic decision-making. Developer advocacy, public communication,
              and cross-functional leadership are core climate tech skills.
            </p>
          </CardExperience>
          <CardExperience
            title="Lead Developer / Fullstack"
            position="Check24 / eH-Visio GmbH"
            time="Oct 2015 - Dec 2017"
            image={jpg_check}
          >
            Extended familiarity with the Symfony Fullstack MVC framework, using
            Doctrine / MongoDB for complex comparison queries. Building a
            vertical comparison portal (eye laser surgeries) & a full fledged,
            in house CRM solution. Lead dev for a team of 6. Direct
            responsibility for product tech stack, deployments & stability.
          </CardExperience>
          <CardExperience
            title="Senior Developer / Fullstack"
            position="Discounto GmbH"
            time="Jan 2014 - Sep 2015"
            href="https://discounto.de"
          >
            Relaunched a heavyweight monolithic custom made PHP application.
            Scaling across 5 BSD servers / 3 data replicas. Full responsibility
            for success. Architected web scraping scheduler & job runner,
            migrated hundreds of web scrapers with the team, managed affiliate
            business model aspects. Rebuilt frontend with Bootstrap.
          </CardExperience>
          <CardExperience
            title="Team Lead / Assistant Manager"
            position="Samsung SDS Europe German Branch"
            time="May 2010 - May 2012"
            href="https://www.samsungsds.com/eu/index.html"
          >
            Leading a developer team of 8. Coding Java Enterprise eCommerce
            applications. Using Oracle SQL (9i), Spring Framework (2), iBATIS
            data mapping
          </CardExperience>
          <CardExperience
            title="Cofounder / CTO"
            position="IQ Studio GbR / AreaDigital AG"
            time="2001 - 2009"
            href="https://web.archive.org/web/20080601000000*/areamobile.de"
          >
            Founded a small agency with 3 friends and published an ezine on
            mobile devices. <em>AreaMobile</em> became one of Germany's most relevant
            tech publications, was listed among the 100 most important German AGOF
            sites. I was fully responsible for technical setup, product development
            and also worked as chief editor for all mobile publications. Cofounder
            and me fully exited the company in 2009. Max headcount: 34, max dev team
            size: 10. AreaMobile was sold several times, most recently belonged to
            Computec Media but was ultimately closed down in 2022.
          </CardExperience>
        </div>

        {/* Projects */}
        <section>
          <h2 class="text-2xl font-semibold mb-4">Projects</h2>
          <div class="space-y-6">
            <CardExperience
              title="Technical Advisor"
              position="Welshare Health"
              time="2024 - 2025"
              href="https://welshare.health"
            >
              Advised on data architectures for health research platforms.
              Supported decentralized storage design, app development strategy,
              and compliance frameworks for research data handling.
            </CardExperience>
            <CardExperience
              title="Head Curator"
              position="Code Talks / AboutYOU"
              time="2020-2022"
              href="https://codetalks.de/"
              image={jpg_ctPanel}
            >
              helped curating Code Talks 2022 (one of Germany's largest dev
              conferences), close collaboration with AboutYOU org team,
              organized panels, did introduction addresses, speaker support,
              managed team of 7 curators
            </CardExperience>
            <CardExperience
              title="Freelancer"
              position="Warranti — Asset Tokenization"
              time="Summer 2022"
              image={jpg_warranti}
            >
              Built proof of concept for asset trading protocol with custom event systems
              for vault tracking and settlement workflows.
            </CardExperience>
          </div>
        </section>

        {/* Detailed Skills Explanation */}
        <section>
          <h2 class="text-2xl font-semibold mb-4">Hard Skills</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
              [
                {
                  name: "TypeScript / Node",
                  experience: "12 years",
                  rating: 5,
                  description:
                    "Built countless TS applications, backends, node servers, database layers, serverless functions, data pipelines, APIs.",
                },
                {
                  name: "React / Modern Frontend",
                  experience: "5 years",
                  rating: 5,
                  description:
                    "All fundamentals: composition, hooks, context, suspense. SSR & SSG. Most familiar with Next.js, Gatsby, Astro. Built complex data visualization and research platforms.",
                },
                {
                  name: "Mathematics & Modeling",
                  experience: "25 years",
                  rating: 4,
                  description:
                    "FH Diploma in Mathematics (TFH Berlin). Deep understanding of algorithms, numerical methods, system modeling. Built economic models, pricing curves, simulation systems.",
                },
                {
                  name: "Database Systems",
                  experience: "22 years",
                  rating: 4,
                  description:
                    "SQL (PostgreSQL, MySQL, SQLite, Oracle) & NoSQL (MongoDB, Redis), Indexers (Elasticsearch), ORMs (Prisma, TypeORM, kysely, Hibernate, Doctrine)",
                },
                {
                  name: "Data Indexing & Querying",
                  experience: "4 years",
                  rating: 4,
                  description:
                    "Built comprehensive indexing systems using GraphQL schemas. Designed efficient data architectures for research platforms, optimized query performance, managed large-scale data ingestion pipelines.",
                },
                {
                  name: "Python / Scientific Computing",
                  experience: "3 years",
                  rating: 3,
                  description:
                    "Jupyter notebooks, numerical simulations, data analysis, scientific modeling. Can build data pipelines and research tooling.",
                },
                {
                  name: "Cryptography & Privacy",
                  experience: "4 years",
                  rating: 4,
                  description:
                    "Privacy-preserving systems, cryptographic access controls, identity infrastructure (W3C DIDs, Verifiable Credentials), secure data sharing architectures.",
                },
                {
                  name: "Decentralized Storage",
                  experience: "4 years",
                  rating: 4,
                  description:
                    "IPFS, Arweave, Filecoin ecosystems. Designed data availability systems for research and scientific data. Understanding of content addressing, data pinning, distributed storage architectures.",
                },
                {
                  name: "DevOps / Infrastructure",
                  experience: "20 years",
                  rating: 3,
                  description:
                    "Cloud (GCP, Digital Ocean, AWS), Docker, CI/CD, monitoring. Can deploy on Kubernetes, manage infrastructure, debug production systems.",
                },
                {
                  name: "PHP / Legacy Systems",
                  experience: "infinite years",
                  rating: 4,
                  description:
                    "Professional Symfony user, conference speaker. Also Laravel, Zend, WordPress. Left ecosystem in 2019, but understand enterprise PHP systems.",
                },
                {
                  name: "Contract Development",
                  experience: "4 years",
                  rating: 4,
                  description:
                    "Built production smart contract systems using Foundry, Hardhat. Deep understanding of fixed-point math, testing strategies, economic mechanism design. Available for specialized applications.",
                },
                {
                  name: "Rust",
                  experience: "1 year",
                  rating: 2,
                  description:
                    "Can write standalone Rust applications, understand ownership model. Built local tooling and performance-critical components.",
                },
              ].map((skill) => <SkillCard {...skill} />)
            }
          </div>
        </section>
      </section>
    </div>
  </main>

  <style>
    main {
    }
  </style>
</Layout>
